# Copy to .env and fill in.  .env is gitignored and must stay that way.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5174

# Binds 127.0.0.1 only. Set BIND_LAN=true to expose the app to your local
# network (e.g. to reach it from your phone) — this REQUIRES APP_PASSWORD.
# The server refuses to start with BIND_LAN=true and no password set.
BIND_LAN=false
APP_PASSWORD=

# Where the SQLite file lives. Defaults to ~/.org/org.db (chmod 600).
# DB_PATH=

# ---------------------------------------------------------------------------
# Plaid — https://dashboard.plaid.com/signup  (free Trial plan, US/CA)
# ---------------------------------------------------------------------------
# sandbox | production.  Build against sandbox; flip to production only once
# the sync pipeline is proven. Sandbox login is user_good / pass_good.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# CA covers the Big 5 + Tangerine; US is needed for Amex cross-border.
PLAID_COUNTRY_CODES=CA,US

# Daily sync time, cron format. Default 06:00 local.
SYNC_CRON=0 6 * * *

# ---------------------------------------------------------------------------
# Anthropic — powers the Ideas tab
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Options research — https://massive.com/  (Options Starter, $29/mo)
# ---------------------------------------------------------------------------
# Polygon rebranded to Massive; polygon.io redirects there. The API, the
# endpoints and the key format are unchanged.
#
# Starter deliberately: historical NBBO quotes are an Advanced-tier ($199/mo)
# entitlement, so backtests over backfilled chains can only fill at last-traded
# prices and are labelled indicative. Forecasting and forward paper trading are
# unaffected — live snapshots carry a real bid and ask. The 15-minute delay
# costs nothing because capture runs after the close.
#
# Run `npm run options:check -w @org/server` after pasting the key.
POLYGON_API_KEY=

# Every outbound request to Polygon/Massive is paced to this many per minute —
# the vendor's per-minute ceiling is undisclosed, and "Unlimited API Calls"
# only means no monthly cap. The first real nightly capture ran well past it:
# 321 of 566 symbols lost to 429s, every night, for three nights running.
# Lower this if 429s persist in a run's error list; raise it once a run shows
# clean headroom (few or no 429s in `errors`, all symbols captured).
POLYGON_MAX_REQUESTS_PER_MINUTE=60

# Where the research corpus lives. One directory so the whole thing is a single
# rsync away from another machine:
#
#   quotes/    Parquet, month-partitioned, zstd — the system of record
#   market.db  SQLite hot window (~90 days) + metadata — rebuildable from quotes/
#   models/    trained model artifacts
#
# Deliberately outside org.db: this reaches gigabytes, and it must never end up
# inside the backup that covers your bank transactions. Defaults to ~/.org/market.
# MARKET_DATA_DIR=
# MARKET_DB_PATH=

# Paper trading lives in its own file, in the same directory but never touched
# by `market:pull`'s single-file rsync of market.db — a paper trade is placed
# from whichever machine you're using, reader as often as runner, and must
# survive the next pull rather than being silently replaced by it. Defaults to
# MARKET_DATA_DIR/paper.db.
# PAPER_DB_PATH=

# Which side of a two-machine setup this is.
#
#   runner   captures chains and trains. Exactly one machine.
#   reader   displays what the runner produced. Never captures, never writes
#            to market.db except by pulling a copy — see RUNNER_SSH_HOST below.
MARKET_ROLE=runner

# --- Reader only ---
#
# The runner's database is never copied directly: it runs in WAL mode, and a
# plain file copy taken mid-write (rsync, a sync client, anything) can land on
# an inconsistent split between the main file and its WAL and produce a
# corrupt read. The runner instead writes a `snapshot.db` after every capture
# — a consistent point-in-time copy via SQLite's own VACUUM INTO — and that is
# the only thing ever transferred.
#
#   npm run market:pull -w @org/server
#
# pulls it over SSH via rsync. Needs Remote Login enabled on the runner
# (System Settings → General → Sharing) and this machine's SSH key in the
# runner's ~/.ssh/authorized_keys.
RUNNER_SSH_HOST=
# Only set if the runner's MARKET_DATA_DIR differs from this machine's.
# RUNNER_DATA_DIR=

# The Python sidecar (services/quant) — pricing, features, training, backtests.
QUANT_URL=http://127.0.0.1:5175

# Chain capture, cron format, interpreted in **US Eastern** rather than your
# local time — this schedule belongs to the market's clock, not yours. Default
# 16:45 ET on weekdays: after the closing prints, and past the 15-minute delay
# on the data plan. A snapshot taken next morning would pair tomorrow's
# underlying price with yesterday's quotes, so this must not drift into the
# following day.
OPTIONS_CAPTURE_CRON=45 16 * * 1-5

# More than one snapshot a day already works — this is only a cron string, and
# the unique index on (contract, instant) makes extra runs safe rather than
# duplicative. For three a day:
#
#   OPTIONS_CAPTURE_CRON=45 9,12,16 * * 1-5
#
# Worth understanding what that buys before turning it on. Options do move
# continuously, but this plan serves no bid or ask, so extra snapshots add more
# *traded* prices rather than prices you could act on. The models forecast over
# multi-day horizons, so intraday rows mostly add noise to a daily label. And
# storage scales linearly against the tightest constraint here — disk.
#
# The case for turning it on is short-dated strategies, where a day is most of
# the contract's remaining life, or once real quotes exist and intraday spread
# movement becomes measurable. Until then, once after the close is the honest
# cadence.

# News/EDGAR ingestion + classification — its own cadence, separate from
# capture above, so a headline doesn't sit unseen until 16:45. US Eastern,
# same as capture. Default every 20 minutes across market hours (9am-5pm ET,
# weekdays); running it through the night would just spend request budget on
# silence. Widen the interval if this starts competing with capture for the
# vendor's rate limit.
TEXT_SYNC_CRON=*/20 9-16 * * 1-5

# Weekly retrain, local time — capture only runs weekdays, so by Sunday the
# corpus already has Friday's close. Registers a new challenger; never
# promotes one — see model_runs' doc comment in schema.ts.
# RETRAIN_CRON=0 8 * * 0

# Artificial starting balance for the paper book, in whole dollars.
# PAPER_STARTING_BALANCE_USD=100000

# SEC EDGAR's fair-access policy requires every request to name a real,
# contactable requester — an unidentified or generic User-Agent gets
# rate-limited or blocked outright. No default on purpose: this has to be
# yours, not a placeholder shipped in this file. Leaving it unset disables
# EDGAR ingestion cleanly rather than sending a request SEC will reject.
#
#   SEC_EDGAR_USER_AGENT=YourName your@email.com
#
# SEC_EDGAR_USER_AGENT=

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
# miladi | shamsi — which calendar leads in the UI
DEFAULT_CALENDAR=miladi
BASE_CURRENCY=CAD
