# Secrets — never commit
.env
.env.local
*.pem
*.key

# The database lives at ~/.org/org.db, outside this repo by design.
# These patterns are belt-and-braces in case anyone points DB_PATH here.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Financial exports dropped in for import
/statements/
*.ofx
*.qfx

# Dependencies & build output
node_modules/
dist/
build/
*.tsbuildinfo

# Editors & OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
logs/

# Machine-local Claude Code permission grants
.claude/settings.local.json

# Any copy of the env file is still the env file. A backup taken before an
# edit carries the same live keys and is not covered by the bare `.env` rule.
.env.*
!.env.example
